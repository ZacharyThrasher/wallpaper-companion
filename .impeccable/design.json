      "html": "<details class=\"ds-filters\"><summary>Filters</summary><p class=\"ds-filter-copy\">Type, tag, and availability controls appear here.</p></details>",
      "css": ".ds-filters{font-family:\"Segoe UI\",system-ui,sans-serif;color:#edeeed;font-size:.875rem}.ds-filters summary{width:fit-content;padding:9px 12px;min-height:42px;border:1px solid #505859;border-radius:5px;cursor:pointer;white-space:nowrap}.ds-filters summary:focus-visible{outline:2px solid var(--focus,#c5e8ff);outline-offset:4px;}.ds-filter-copy{margin:16px 0 0;color:var(--muted,#aeb5b5);font-size:.8rem}"
    }
  ],
  "narrative": {
    "northStar": "The Quiet Local Gallery",
    "overview": "A charcoal workspace gives wallpaper imagery the visual lead. Familiar system typography, restrained sage selection, and compact native controls keep the interface calm and immediately usable.\n\nThe system favors useful density and progressive disclosure: titles and previews support scanning; additional metadata appears when requested. Surfaces are understated, with tonal differences and fine borders providing structure.",
    "keyCharacteristics": [
      "Charcoal surfaces with pale primary ink and readable secondary ink.",
      "Segoe UI and system sans throughout the interface.",
      "Restrained sage selection and distinct keyboard focus.",
      "Image-led content with flat captions and native controls.",
      "Optional details and disclosures that protect the scanning rhythm."
    ],
    "rules": [
      {
        "name": "The State Has Meaning Rule",
        "body": "Reserve sage for selection and small functional accents; availability and warning colors accompany readable status text.",
        "section": "colors"
      },
      {
        "name": "The Familiar Voice Rule",
        "body": "Use the same system sans across controls and content; establish hierarchy through size, weight, and spacing.",
        "section": "typography"
      },
      {
        "name": "The Progressive Disclosure Rule",
        "body": "Keep source paths, diagnostics, and secondary filters behind native disclosures until requested.",
        "section": "layout"
      },
      {
        "name": "The Tonal Structure Rule",
        "body": "Separate regions through tone and spacing; keep gallery images on the canvas without enclosing raised cards.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do let wallpaper imagery lead while controls and metadata stay quiet.",
      "Do preserve native selects, disclosures, visible labels, and keyboard focus.",
      "Do pair state colors with explicit text and preserve unavailable image regions.",
      "Do use progressive disclosure for source paths, diagnostics, and secondary filters.",
      "Do preserve long-title wrapping and the narrow selector with inline details."
    ],
    "donts": [
      "Don't add decorative gradients, nested cards, or emojis.",
      "Don't turn library browsing into a metrics dashboard.",
      "Don't use sage as a large decorative fill.",
      "Don't expose all source metadata in the primary scanning view.",
      "Don't replace the approved system sans with decorative display typography."
    ]
  }
}
