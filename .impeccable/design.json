      "css": ".ds-view{font-family:\"Segoe UI\",system-ui,sans-serif;display:flex;gap:12px;align-items:center;font-size:.8rem;color:var(--muted,#aeb5b5)}.ds-view select{font-family:\"Segoe UI\",system-ui,sans-serif;font-size:1rem;flex:1;min-width:0;max-width:100%;color:#edeeed;background:var(--rail,#141617);border:1px solid #505859;border-radius:5px;min-height:42px;padding:9px 12px;cursor:pointer;color-scheme:dark}.ds-view select:focus-visible{outline:2px solid var(--focus,#c5e8ff);outline-offset:4px;}"
