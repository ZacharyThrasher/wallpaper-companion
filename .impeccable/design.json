      "html": "<nav class=\"ds-nav\" aria-label=\"Library and playlists\"><button class=\"ds-nav-item ds-nav-selected\" aria-current=\"page\">All wallpapers <span>24</span></button><button class=\"ds-nav-item\">Evening collection <span>6</span></button></nav>",
      "css": ".ds-nav{font-family:\"Segoe UI\",system-ui,sans-serif;width:232px;background:var(--rail,#141617);padding:16px}.ds-nav-item{font-family:\"Segoe UI\",system-ui,sans-serif;display:flex;align-items:center;justify-content:space-between;gap:12px;width:100%;text-align:left;font-size:.875rem;color:#edeeed;background:transparent;border:0;border-radius:5px;padding:11px 12px;min-height:44px;cursor:pointer}.ds-nav-item span{font-size:.75rem;color:var(--muted,#aeb5b5);font-variant-numeric:tabular-nums}.ds-nav-item:hover{background:#303536}.ds-nav-item:active{background:#3b4341}.ds-nav-selected{background:#29352e;color:#d1e7d7}.ds-nav-selected span{color:#c3d6c9}.ds-nav-item:focus-visible{outline:2px solid var(--focus,#c5e8ff);outline-offset:4px;}"
    },
