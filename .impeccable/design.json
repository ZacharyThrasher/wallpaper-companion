      "html": "<button class=\"ds-wallpaper\" aria-pressed=\"true\"><span class=\"ds-preview\">No image preview</span><span class=\"ds-caption\"><strong>Evening landscape</strong><span class=\"ds-meta\">Scene</span></span></button>",
      "css": ".ds-wallpaper{font-family:\"Segoe UI\",system-ui,sans-serif;display:block;width:260px;background:transparent;border:0;border-radius:0;padding:0;text-align:left;color:#edeeed;cursor:pointer}.ds-preview{display:flex;aspect-ratio:16/10;align-items:center;justify-content:center;background:#232829;border-radius:8px;color:#c3cbca;font-size:.875rem;outline:1px solid transparent;outline-offset:3px;transition:outline-color 160ms ease-out}.ds-caption{display:block;padding-top:12px;line-height:1.4}.ds-caption strong{font-size:.875rem;font-weight:500;overflow-wrap:anywhere}.ds-meta{display:block;margin-top:4px;font-size:.75rem;color:var(--muted,#aeb5b5)}.ds-wallpaper:hover .ds-preview{outline-color:#6e7a75}.ds-wallpaper[aria-pressed=true] .ds-preview{outline:2px solid var(--accent,#b5d6be)}.ds-wallpaper:focus-visible{outline:2px solid var(--focus,#c5e8ff);outline-offset:4px;}@media(prefers-reduced-motion:reduce){.ds-preview{transition:none}}"
    },
    {
      "name": "Native Filter Disclosure",
