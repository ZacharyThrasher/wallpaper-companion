      "css": ".ds-search{font-family:\"Segoe UI\",system-ui,sans-serif;display:block;max-width:480px;font-size:.8rem;color:var(--muted,#aeb5b5)}.ds-search input{font-family:\"Segoe UI\",system-ui,sans-serif;display:block;margin-top:7px;font-size:1rem;color:#edeeed;background:var(--rail,#141617);border:1px solid #505859;border-radius:5px;min-height:42px;padding:9px 12px;width:100%;caret-color:var(--accent,#b5d6be)}.ds-search input::placeholder{color:var(--muted,#aeb5b5)}.ds-search input:focus-visible{outline:2px solid var(--focus,#c5e8ff);outline-offset:4px;}"
